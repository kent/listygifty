# Pin gcloud to the listygifty project and account inside this repo, whatever
# configuration is active globally (this machine has several). CLOUDSDK_*
# variables override the active gcloud configuration. Run `direnv allow` once.
# Put personal overrides in .envrc.local (gitignored).
export CLOUDSDK_CORE_PROJECT=listygifty
export CLOUDSDK_CORE_ACCOUNT=kent.fenwick@gmail.com
export CLOUDSDK_COMPUTE_REGION=us-central1
export CLOUDSDK_RUN_REGION=us-central1

source_env_if_exists .envrc.local
