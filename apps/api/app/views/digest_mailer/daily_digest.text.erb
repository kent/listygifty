<%= @digest_date %>

<%= pluralize(@total_gifts, "new gift") %> added to your shared lists.

<% @changes_by_holiday.each do |holiday, changes| -%>
<% authors = @authors_by_holiday.fetch(holiday) -%>
<%= holiday.name %> · <%= pluralize(changes.size, "new gift") %>
<% if authors.one? -%>
Added by <%= authors.first %>
<% end -%>

<% changes.each do |change| -%>
<% gift = change.gift -%>
<% item_url = gift_url(holiday, gift) -%>
• <%= gift_label(change) %> [<%= gift_status(gift) %>]
<% if item_url -%>
  <%= item_url %>
<% end -%>
<% if gift&.recipients&.any? -%>
  For <%= gift.recipients.map(&:name).join(", ") %>
<% end -%>
<% if gift&.givers&.any? -%>
  From <%= gift.givers.map(&:name).join(", ") %>
<% end -%>
<% if authors.many? -%>
  Added by <%= added_by(change.user) %>
<% end -%>
<% end -%>

Open list: <%= @frontend_url %>/holidays/<%= holiday.id %>

