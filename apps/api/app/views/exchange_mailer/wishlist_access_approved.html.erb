<% content_for :preview_text do %><%= @requested.display_name %> said yes. Their wishlist is open to you.<% end %>

<h1 style="margin: 0 0 8px 0; font-size: 24px; font-weight: 700; color: #18181b;">
  <%= @requested.display_name %> said yes.
</h1>
<p style="margin: 0 0 24px 0; font-size: 16px; color: #52525b;">
  Hi <strong><%= @participant.display_name %></strong>. You can now see
  <%= @requested.display_name %>'s wishlist in <strong><%= @exchange.name %></strong>.
</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td align="center">
      <a href="<%= @wishlist_url %>" class="button" style="display: inline-block; padding: 14px 32px; background: linear-gradient(135deg, #a855f7, #ec4899); color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; border-radius: 10px;">
        See Their Wishlist
      </a>
    </td>
  </tr>
</table>
