FROM ruby:3.4-slim

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      curl \
      libpq-dev \
      libvips \
      libyaml-dev \
      git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3001

CMD ["bash", "-lc", "bin/rails db:prepare && exec bin/rails server -b 0.0.0.0 -p 3001"]
