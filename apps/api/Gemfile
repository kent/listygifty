source "https://rubygems.org"

gem "rails", "~> 8.1.1"
gem "pg", "~> 1.5"
gem "puma", "~> 7.2"
gem "csv" # Required for Ruby 3.4+
gem "ostruct" # No longer a default gem in Ruby 4.0; used by the app and clerk-sdk-ruby

# Authentication (Clerk)
gem "clerk-sdk-ruby", require: "clerk"

# API
gem "rack-cors"
gem "rack-attack"
gem "blueprinter"
gem "oj"

# Payments
# Each stripe major pins a newer Stripe API version. 20.0 (API 2026-09-30+)
# drops Checkout's `payment_method_types`, which BillingController sends, so
# moving past 18.x is a deliberate API migration verified in Stripe test mode.
gem "stripe", "~> 18.0"

# Email
gem "postmark-rails"

# Background jobs (PostgreSQL-backed)
gem "solid_queue"

# AI
gem "ruby-openai"

# Analytics

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "~> 1.2"
gem "google-cloud-storage", "~> 1.60"
# Reads product pages for the photo they show
gem "nokogiri"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false
  gem "brakeman", ">= 8.0.4", require: false
  gem "rubocop-rails-omakase", require: false
  gem "dotenv-rails"
end

group :test do
  gem "capybara"
  gem "selenium-webdriver"
gem "minitest", "< 6.0" # Pin to avoid compatibility issues with Rails 8.1
end
