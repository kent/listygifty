{
  "name": "niftygifty",
  "private": true,
  "engines": {
    "node": ">=20 <24"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "deploy:staging": "bash infra/pulumi/scripts/deploy.sh staging",
    "deploy:production": "bash infra/pulumi/scripts/deploy.sh production",
    "deploy:preview:staging": "cd infra/pulumi && pulumi preview --stack staging",
    "deploy:preview:production": "cd infra/pulumi && pulumi preview --stack production",
    "infra:bootstrap": "bash infra/gcp/scripts/bootstrap.sh",
    "infra:sync-secrets": "bash infra/gcp/scripts/sync-heroku-secrets.sh",
    "infra:migrate-db": "bash infra/gcp/scripts/migrate-heroku-db.sh",
    "infra:verify-db": "bash infra/gcp/scripts/verify-migration.sh",
    "infra:seed:review": "bash infra/gcp/scripts/seed-app-review-data.sh"
  },
  "devDependencies": {
    "schema-dts": "^1.1.5",
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.2.0",
  "overrides": {
    "react-test-renderer": "19.2.0"
  }
}
